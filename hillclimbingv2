def objective_function(x):
    return -4 * (x - 5) ** 2 + 100


def hill_climbing(start, step_size, max_iterations):
    current_state = start
    current_value = objective_function(current_state)

    print("\n----- Hill Climbing Starts -----")
    print(f"{'Iter':<5}{'Current':<10}{'Value':<10}{'Left':<10}{'Right':<10}{'Decision'}")
    print("-" * 70)

    for i in range(1, max_iterations + 1):

        left = current_state - step_size
        right = current_state + step_size

        left_value = objective_function(left)
        right_value = objective_function(right)

        decision = "Stop"

        if left_value > current_value and left_value >= right_value:
            decision = "Move Left"
            current_state = left
            current_value = left_value

        elif right_value > current_value:
            decision = "Move Right"
            current_state = right
            current_value = right_value

        print(f"{i:<5}{current_state:<10.2f}{current_value:<10.2f}{left:<10.2f}{right:<10.2f}{decision}")

        if decision == "Stop":
            break

    print("\n----- Result -----")
    print(f"Optimal State : {current_state}")
    print(f"Optimal Value : {current_value}")

    return current_state, current_value

start = float(input("Enter starting point: "))
step_size = float(input("Enter step size: "))
max_iterations = int(input("Enter maximum iterations: "))

hill_climbing(start, step_size, max_iterations)